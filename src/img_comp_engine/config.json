        }
      ],
      "blend": "difference",
      "opacity": 0.4
    },
    {
      "image": "animal.jpg",
      "filters": [
        {
          "name": "invert"
        }
      ],
      "blend": "normal",
      "opacity": 0.7
    }
  ]
}