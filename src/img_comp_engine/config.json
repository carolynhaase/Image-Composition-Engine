{
  "layers": [
    {
      "image": "stones.jpg",
      "filters": [
        {
          "name": "gaussianblur",
          "params": {
            "window": 11,
            "sigma": 3.0
          }
        }
      ]
    },
    {
      "image": "colors.jpg",
      "filters": [
        {
          "name": "brightness",
          "params": {
            "level": 0
