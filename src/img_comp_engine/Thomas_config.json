{
  "layers": [
    {
      "image": "stones.jpg",
             "filters": [
                {
                    "name": "blend",
                    "params": {
                        "image2": "animal.jpg",
                        "intensity": 50
                    }
                },
                {
                    "name": "contrast",
                    "params": {
                        // 50 conserve le contraste original ; 0 le réduit au minimum.
                        "intensity": 50
                    }
                },
                {
                    "name": "saturation",
                    "params": {
                        // 50 conserve la saturation originale ; 0 passe en niveaux de gris.
                        "intensity": 50
                    }
                },
                {
                    "name": "selectivecolor",
                    "params": {
                        // [R, G, B] - couleur à sélectionner (de 0 à 255 pour chaque composante)
                        "color": [0, 255, 0],
                        // 0 le réduit au minimum ; 100 le maximise
                        "intensity": 0
                    }
                },
                {
                    "name": "centercirclefocus",
                    "params": {
                        // 0 le réduit au minimum ; 100 le maximise
                        "intensity": 0,
                        // Taille du cercle de mise au point (0 à 100)
                        "focus_size": 100
                    }
                }
            ],
            "blend": "normal",
            "opacity": 1.0
        }
    ]
}